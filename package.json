{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:geometry": "node scripts/check-hall.mjs && node scripts/check-galleries.mjs && node scripts/check-skills.mjs && node scripts/check-museum-structure.mjs",
    "test:components": "vite build --ssr scripts/check-components.tsx --outDir node_modules/.tmp/component-check --emptyOutDir && node node_modules/.tmp/component-check/check-components.js",
    "test:responsive": "npm run build && node scripts/check-responsive.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
